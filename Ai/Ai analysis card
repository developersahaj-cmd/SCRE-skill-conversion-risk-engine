import React from "react";



import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

import { Button } from "@/components/ui/button";

import { Badge } from "@/components/ui/badge";

import { Sparkles, CheckCircle, XCircle, Edit } from "lucide-react";

import { motion } from "framer-motion";



// SAFE INTEGRATION LAYER (Non-breaking)

// NOTE: All integrations are OPTIONAL, ISOLATED, and FAIL-SAFE.

// - No new top-level imports for Firebase/Gemini/BigQuery/Vertex AI.

// - Everything is lazy-loaded, guarded, and defaults to no-op.

// - Feature flags default OFF to preserve 100% backward compatibility.

const __SCRE_INTEGRATIONS__ = (() => {

  const isBrowser = typeof window !== "undefined";



  const safeGet = (fn, fallback) => {

    try {

      return fn();

    } catch {

      return fallback;

    }

  };



  const getFlag = (key) => {

    // Priority: globalThis.__SCRE_FEATURES__ (runtime) -> process.env (if present)

    const fromGlobal = safeGet(

      () => (globalThis && globalThis.__SCRE_FEATURES__ && globalThis.__SCRE_FEATURES__[key]) || false,

      false

    );

    if (typeof fromGlobal === "boolean") return fromGlobal;



    const fromEnv = safeGet(() => {

      // Guard process/env access (e.g., in some runtimes it's undefined)

      // eslint-disable-next-line no-undef

      const env = typeof process !== "undefined" && process && process.env ? process.env : {};

      const raw = env[`SCRE_FEATURE_${String(key).toUpperCase()}`];

      if (!raw) return false;

      return ["1", "true", "yes", "on"].includes(String(raw).toLowerCase());

    }, false);



    return !!fromEnv;

  };



  // SAFE INTEGRATION LAYER (Non-breaking)

  // BigQuery analytics (async, fire-and-forget). No-op by default.

  const logAnalyticsEvent = async (_eventName, _payload) => {

    if (!getFlag("bigquery")) return;

    try {

      // Lazy-load a local adapter if your app defines it.

      // This avoids adding breaking imports and keeps integration isolated.

      if (isBrowser && globalThis && typeof globalThis.__SCRE_BIGQUERY_LOGGER__ === "function") {

        await globalThis.__SCRE_BIGQUERY_LOGGER__(_eventName, _payload);

        return;

      }

      // Optional: dynamic import of a project-local module (safe-guarded).

      // Uncomment only if such module exists in your codebase.

      // const mod = await import("@/integrations/bigquery");

      // await mod.logEvent(_eventName, _payload);

    } catch {

      // Swallow errors to ensure the app never crashes.

    }

  };



  // SAFE INTEGRATION LAYER (Non-breaking)

  // Gemini insight generation (non-blocking). Returns null on failure.

  const generateGeminiInsight = async (_prompt) => {

    if (!getFlag("gemini")) return null;

    try {

      if (isBrowser && globalThis && typeof globalThis.__SCRE_GEMINI_INSIGHTS__ === "function") {

        return await globalThis.__SCRE_GEMINI_INSIGHTS__(_prompt);

      }

      // Optional: dynamic import of a project-local module (safe-guarded).

      // const mod = await import("@/integrations/gemini");

      // return await mod.generateInsight(_prompt);

      return null;

    } catch {

      return null;

    }

  };



  // SAFE INTEGRATION LAYER (Non-breaking)

  // Firebase auth/profile persistence (optional). No-op by default.

  const getFirebaseUser = async () => {

    if (!getFlag("firebase")) return null;

    try {

      if (isBrowser && globalThis && globalThis.__SCRE_FIREBASE_AUTH__) {

        return safeGet(() => globalThis.__SCRE_FIREBASE_AUTH__.currentUser || null, null);

      }

      // Optional: dynamic import of a project-local module (safe-guarded).

      // const mod = await import("@/integrations/firebase");

      // return await mod.getCurrentUser();

      return null;

    } catch {

      return null;

    }

  };



  // SAFE INTEGRATION LAYER (Non-breaking)

  // Vertex AI inference behind abstraction layer. Returns null/empty on failure.

  const vertexInfer = async (_input) => {

    if (!getFlag("vertex")) return null;

    try {

      if (isBrowser && globalThis && typeof globalThis.__SCRE_VERTEX_INFER__ === "function") {

        return await globalThis.__SCRE_VERTEX_INFER__(_input);

      }

      // Optional: dynamic import of a project-local module (safe-guarded).

      // const mod = await import("@/integrations/vertex");

      // return await mod.infer(_input);

      return null;

    } catch {

      return null;

    }

  };



  // SAFE INTEGRATION LAYER (Non-breaking)

  // Vertex Explainable AI enrichment (only if available). Returns empty list on failure.

  const vertexExplain = async (_input) => {

    if (!getFlag("vertex_explain")) return [];

    try {

      if (isBrowser && globalThis && typeof globalThis.__SCRE_VERTEX_EXPLAIN__ === "function") {

        return (await globalThis.__SCRE_VERTEX_EXPLAIN__(_input)) || [];

      }

      // Optional: dynamic import of a project-local module (safe-guarded).

      // const mod = await import("@/integrations/vertexExplain");

      // return (await mod.explain(_input)) || [];

      return [];

    } catch {

      return [];

    }

  };



  return {

    getFlag,

    logAnalyticsEvent,

    generateGeminiInsight,

    getFirebaseUser,

    vertexInfer,

    vertexExplain,

  };

})();



export default function AIAnalysisCard({

  title,

  content,

  confidence,

  status = "pending",

  onAccept,

  onReject,

  onModify,

  showActions = true,

}) {

  const getConfidenceColor = (score) => {

    if (score >= 80) return "text-emerald-600 bg-emerald-50";

    if (score >= 60) return "text-blue-600 bg-blue-50";

    if (score >= 40) return "text-amber-600 bg-amber-50";

    return "text-red-600 bg-red-50";

  };



  // SAFE INTEGRATION LAYER (Non-breaking)

  // Wrap callbacks to optionally emit analytics/insights without altering default behavior.

  const safeCall = (fn) => {

    try {

      if (typeof fn === "function") fn();

    } catch {

      // Never crash UI if user handlers throw.

    }

  };



  const safeFireAndForget = (promiseFactory) => {

    try {

      const p = promiseFactory?.();

      // Avoid unhandled rejections

      if (p && typeof p.then === "function") p.catch(() => {});

    } catch {

      // no-op

    }

  };



  const handleAccept = () => {

    safeCall(onAccept);



    // SAFE INTEGRATION LAYER (Non-breaking)

    safeFireAndForget(() =>

      __SCRE_INTEGRATIONS__.logAnalyticsEvent("ai_analysis_card_accept", {

        title,

        confidence: confidence ?? null,

        status,

      })

    );



    // SAFE INTEGRATION LAYER (Non-breaking)

    // Non-blocking: if enabled, can generate an optional insight; result is ignored here to preserve UX.

    safeFireAndForget(() => __SCRE_INTEGRATIONS__.generateGeminiInsight(String(content ?? "")));

  };



  const handleReject = () => {

    safeCall(onReject);



    // SAFE INTEGRATION LAYER (Non-breaking)

    safeFireAndForget(() =>

      __SCRE_INTEGRATIONS__.logAnalyticsEvent("ai_analysis_card_reject", {

        title,

        confidence: confidence ?? null,

        status,

      })

    );

  };



  const handleModify = () => {

    safeCall(onModify);



    // SAFE INTEGRATION LAYER (Non-breaking)

    safeFireAndForget(() =>

      __SCRE_INTEGRATIONS__.logAnalyticsEvent("ai_analysis_card_modify", {

        title,

        confidence: confidence ?? null,

        status,

      })

    );

  };



  return (

    <motion.div

      initial={{ opacity: 0, scale: 0.95 }}

      animate={{ opacity: 1, scale: 1 }}

      transition={{ duration: 0.2 }}

    >

      <Card className="border-slate-200 hover:border-slate-300 transition-colors">

        <CardHeader>

          <div className="flex items-start justify-between">

            <div className="flex items-center space-x-2">

              <Sparkles className="w-5 h-5 text-purple-500" />

              <CardTitle className="text-base font-semibold text-slate-900">{title}</CardTitle>

            </div>



            {typeof confidence === "number" && (

              <Badge className={getConfidenceColor(confidence)}>{confidence}% confidence</Badge>

            )}

          </div>

        </CardHeader>



        <CardContent>

          <p className="text-sm text-slate-700 mb-4">{content}</p>



          {showActions && status === "pending" && (

            <div className="flex items-center space-x-2">

              <Button

                size="sm"

                onClick={handleAccept}

                className="bg-emerald-600 hover:bg-emerald-700 text-white"

              >

                <CheckCircle className="w-4 h-4 mr-1" />

                Accept

              </Button>



              <Button

                size="sm"

                variant="outline"

                onClick={handleReject}

                className="border-red-300 text-red-600 hover:bg-red-50"

              >

                <XCircle className="w-4 h-4 mr-1" />

                Reject

              </Button>



              {typeof onModify === "function" && (

                <Button size="sm" variant="outline" onClick={handleModify}>

                  <Edit className="w-4 h-4 mr-1" />

                  Modify

                </Button>

              )}

            </div>

          )}



          {status === "accepted" && (

            <Badge className="bg-emerald-100 text-emerald-800">

              <CheckCircle className="w-3 h-3 mr-1" />

              Accepted

            </Badge>

          )}



          {status === "rejected" && (

            <Badge className="bg-red-100 text-red-800">

              <XCircle className="w-3 h-3 mr-1" />

              Rejected

            </Badge>

          )}

        </CardContent>

      </Card>

    </motion.div>

  );

}
