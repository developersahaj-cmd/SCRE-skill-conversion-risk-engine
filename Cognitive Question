/* -------------------------------------------------------

 * Insights / Tips (AI-integrated safely)

 * - Provide non-deterministic, resource-like suggestions

 * ----------------------------------------------------- */



function safeTipsForSkill(skill, derivedSignals, contextMode) {

  // Simple heuristic tips based on derived signals; phrased as options, not prescriptions.

  const s = derivedSignals?.perSkill?.[skill]?.signals || {};

  const tips = [];



  if (s.delayedFeedbackSensitivity?.includes("more sensitive")) {

    tips.push("You might prefer shorter feedback loops (smaller milestones, quick checks) to keep motivation steady in this context.");

  }

  if (s.ambiguityComfort?.includes("less comfortable")) {

    tips.push("If ambiguity feels heavy right now, you could try a more scaffolded start (examples, templates, or guided checklists), then gradually remove supports.");

  }

  if (contextMode === "job") {

    tips.push("For job context, consider setting “definition of done” early to reduce rework churn under deadlines.");

  }

  if (contextMode === "hobby") {

    tips.push("For hobby context, consider playful constraints (time-boxing, tiny experiments) to keep the loop enjoyable.");

  }



  if (tips.length === 0) {

    tips.push("No strong signals detected here. If you want more detail, you can retake with a clearer context (job vs hobby) or add a micro-task.");

  }



  return tips;

}



