  },

];



/* -------------------------------------------------------

 * Contradiction checks (non-judgmental; no labeling)

 * ----------------------------------------------------- */



function contradictionChecks({ stage2Answers, situationalAnswers }) {

  const flags = [];



  // Helper to read answers safely

  const get = (skill, qid) => stage2Answers?.[skill]?.[qid];

  const add = (skill, msg) => flags.push({ skill, message: msg });



  // Coding contradictions: persistence vs exhaustion

  if (stage2Answers?.["Coding"]) {

    const exhaustion = get("Coding", "coding_q1"); // scale 1-5

    const persist = get("Coding", "coding_q2"); // frequency

    if (

      typeof exhaustion === "number" &&

      typeof persist === "string" &&

      exhaustion <= 2 &&

      (persist === "Often" || persist === "Very often")

    ) {

      add(

        "Coding",

        "Your answers suggest you often keep trying after failed attempts, while also tending to feel mentally exhausted fairly quickly when the cause is unclear. This could reflect context differences (time pressure, fatigue, task type), or it could be worth retaking later."

      );

    }

  }



  // Delayed feedback sensitivity cross-skill consistency (example)

  const delayedImpact = [];

  for (const skill of Object.keys(stage2Answers || {})) {

    for (const [qid, val] of Object.entries(stage2Answers[skill] || {})) {

      const q = (NEW_STAGE2_QUESTIONS[skill] || []).find((x) => x.id === qid);

      if (q?.intent?.includes("delayed") && typeof val === "string") {

        delayedImpact.push({ skill, val });

      }

      if (q?.intent?.includes("delayed") && typeof val === "number") {

        delayedImpact.push({ skill, val });

      }

    }

  }

  // Flag only if extreme spread exists (non-deterministic, just a nudge)

  const numeric = delayedImpact

    .map((x) => (typeof x.val === "number" ? x.val : null))

    .filter((x) => x != null);



  if (numeric.length >= 2) {

    const min = Math.min(...numeric);

    const max = Math.max(...numeric);

    if (max - min >= 3) {

      flags.push({

        skill: "Cross-skill",

        message:

          "Your responses around delayed feedback/validation vary a lot across skills. That can be totally normal (different motivation contexts), but it might help to answer with a specific context in mind (job vs hobby).",

      });

    }

  }



  // Situational checks: open text too short or empty (prompt a gentle note)

  for (const [skill, answers] of Object.entries(situationalAnswers || {})) {

    const questions = SITUATIONAL_STAGE2[skill] || [];

    for (const q of questions) {

      if (q.openText) {

        const a = answers?.[q.id];

        if (typeof a === "string" && a.trim().length > 0 && a.trim().length < 8) {

          add(

            skill,

            "One of your short responses is very brief. If you want more detailed insights, a bit more context can help (1–2 sentences). You can redo it."

          );

        }

      }

    }

  }



  return flags;

}



/* -------------------------------------------------------

 * Lightweight signal extraction (no labels; no determinism)

 * ----------------------------------------------------- */



function deriveSignals({ stage2Answers, situationalAnswers, microTaskAnswers, contextMode }) {

  // contextMode: "job" | "hobby" | "unspecified"

  const derived = {

    contextMode,

    perSkill: {},

    microSignals: {

      abstractionPreference: "neutral",

      loadHandling: "neutral",

      confidence: "low",

      notes: [],

    },

  };



  // Micro-signal (session-only, neutral by default)

  if (microTaskAnswers?.mt1 != null) {

    const mt1Choice = MICRO_TASKS[0].choices[microTaskAnswers.mt1];

    if (typeof mt1Choice === "string") {

      if (mt1Choice.includes("concrete example")) derived.microSignals.abstractionPreference = "leans concrete (session-only)";

      if (mt1Choice.includes("general rule")) derived.microSignals.abstractionPreference = "leans abstract (session-only)";

      if (mt1Choice.includes("step-by-step")) derived.microSignals.abstractionPreference = "leans procedural (session-only)";

      if (mt1Choice.includes("high-level")) derived.microSignals.abstractionPreference = "leans overview-first (session-only)";

    }

  }

  if (microTaskAnswers?.mt2 != null) {

    const mt2Choice = MICRO_TASKS[1].choices[microTaskAnswers.mt2];

    if (typeof mt2Choice === "string") {

      if (mt2Choice.includes("fewer options")) derived.microSignals.loadHandling = "prefers lower option-load (session-only)";

      if (mt2Choice.includes("few options")) derived.microSignals.loadHandling = "okay with moderate option-load (session-only)";

      if (mt2Choice.includes("many options")) derived.microSignals.loadHandling = "prefers exploring more options (session-only)";

      if (mt2Choice.includes("pausing")) derived.microSignals.loadHandling = "prefers pause-and-return (session-only)";

    }

  }



  // Per-skill derived feature sketch (kept minimal; no raw answers)

  for (const skill of SKILLS) {

    const answers = stage2Answers?.[skill] || {};

    const questions = NEW_STAGE2_QUESTIONS[skill] || [];



    // Minimal derived feature: delayed feedback sensitivity (if present)

    const delayedItems = questions.filter((q) => q.intent.includes("delayed"));

    let delayed = null;

    for (const q of delayedItems) {

      const v = answers[q.id];

      if (typeof v === "number") delayed = v;

      if (typeof v === "string") {

        // Map impact categories to rough 1-4; still just a proxy

        const map = { "Low": 1, "Moderate": 2, "High": 3, "Very high": 4 };

        if (map[v] != null) delayed = map[v];

      }

    }



    // Minimal derived: ambiguity comfort (if present)

    const ambiguityQ = questions.find((q) => q.intent.includes("ambiguity"));

    let ambiguity = null;

    if (ambiguityQ) {

      const v = answers[ambiguityQ.id];

      if (typeof v === "number") ambiguity = v;

    }



    derived.perSkill[skill] = {

      // Keep these as "signals" not scores, and keep confidence low

      signals: {

        delayedFeedbackSensitivity: delayed == null ? "neutral" : delayed >= 3 ? "more sensitive (session-only)" : "less sensitive (session-only)",

        ambiguityComfort: ambiguity == null ? "neutral" : ambiguity >= 4 ? "more comfortable (session-only)" : ambiguity <= 2 ? "less comfortable (session-only)" : "mixed (session-only)",

      },

      confidence: "low",

      notes: [],

    };

  }



  return derived;

}



/* -------------------------------------------------------

 * Report export (JSON) - ensures export works properly

 * ----------------------------------------------------- */



function downloadJSON(filename, dataObj) {

  const blob = new Blob([JSON.stringify(dataObj, null, 2)], { type: "application/json" });

  const url = URL.createObjectURL(blob);

  const a = document.createElement("a");

  a.href = url;

  a.download = filename;

  document.body.appendChild(a);

  a.click();

  a.remove();

  URL.revokeObjectURL(url);

}



