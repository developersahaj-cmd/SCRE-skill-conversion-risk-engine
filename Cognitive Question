            <div style={styles.kvKey}>Load handling</div>

            <div style={styles.kvVal}>{derived.microSignals.loadHandling}</div>

          </div>

          <div style={styles.kvRow}>

            <div style={styles.kvKey}>Confidence</div>

            <div style={styles.kvVal}>{derived.microSignals.confidence}</div>

          </div>

        </div>

      </Card>



      <Card title="Stage-2 skill signals (derived)">

        <div style={{ display: "grid", gap: 8 }}>

          <div style={styles.kvRow}>

            <div style={styles.kvKey}>Delayed feedback sensitivity</div>

            <div style={styles.kvVal}>{perSkill?.signals?.delayedFeedbackSensitivity || "neutral"}</div>

          </div>

          <div style={styles.kvRow}>

            <div style={styles.kvKey}>Ambiguity comfort</div>

            <div style={styles.kvVal}>{perSkill?.signals?.ambiguityComfort || "neutral"}</div>

          </div>

          <div style={styles.kvRow}>

            <div style={styles.kvKey}>Confidence</div>

            <div style={styles.kvVal}>{perSkill?.confidence || "low"}</div>

          </div>

        </div>



        <div style={{ marginTop: 10, color: styles.muted.color, fontSize: 13 }}>

          Interpretation note: “more/less comfortable” refers to how the answers read <em>in this session</em>, not a fixed trait.

        </div>

      </Card>



      <Card title="Consistency & contradiction checks">

        {flags.length === 0 ? (

          <div style={{ color: styles.muted.color }}>

            No notable contradictions detected. (This is not a validation of truth—just no strong mismatches found.)

          </div>

        ) : (

          <div style={{ display: "grid", gap: 10 }}>

            {flags.map((f, idx) => (

              <div key={idx} style={styles.flagRow}>

                <Pill>{f.skill}</Pill>

                <div style={{ marginLeft: 10 }}>{f.message}</div>

              </div>

            ))}

          </div>

        )}

      </Card>



      <Card title="Personalized tips & resources (non-prescriptive)">

        <ul style={{ margin: 0, paddingLeft: 18 }}>

          {tips.map((t, idx) => (

            <li key={idx} style={{ marginBottom: 8 }}>{t}</li>

          ))}

        </ul>

        <div style={{ marginTop: 10, fontSize: 12, color: styles.muted.color }}>

          If you connect a backend adapter, you can replace these heuristics with model-assisted suggestions while keeping neutral defaults.

        </div>

      </Card>



      <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>

        {/* FIX: Start new assessment button visibility (was white) */}

        <PrimaryButton onClick={onStartNew}>Start New Assessment</PrimaryButton>



        {/* FIX: Export report button visibility + proper function */}

        <PrimaryButton onClick={onExport}>Export Report</PrimaryButton>

      </div>

    </div>

  );

}



/* -------------------------------------------------------

 * Progress Page (session-only, aggregated)

 * ----------------------------------------------------- */



function ProgressPage({ progress }) {

  const skillsCompleted = Object.keys(progress.completions || {}).length;



  function fmtMs(ms) {

    const s = Math.round((ms || 0) / 1000);

    if (s < 60) return `${s}s`;

    const m = Math.floor(s / 60);

    const r = s % 60;

    return `${m}m ${r}s`;

  }



  return (

    <div style={{ padding: 18 }}>

      <div style={{ display: "grid", gap: 14, maxWidth: 980, margin: "0 auto" }}>

        <Card title="Progress Overview">

          <div style={{ display: "grid", gap: 8 }}>

            <div style={styles.kvRow}>

              <div style={styles.kvKey}>Skills completed (this session)</div>

              <div style={styles.kvVal}>{skillsCompleted}/{SKILLS.length}</div>

            </div>

            <div style={{ color: styles.muted.color, fontSize: 13 }}>

              This page visualizes completion and time spent using session-only aggregates. For long-term tracking, store only aggregated metrics server-side (avoid raw answers).

            </div>

          </div>

        </Card>



        <Card title="Per-skill breakdown">

          <div style={{ display: "grid", gap: 10 }}>

            {SKILLS.map((s) => {

              const c = progress.completions?.[s];

              const t = progress.timeSpentMs?.[s] || 0;

              const sig = progress.performanceSignals?.[s];



              return (

                <div key={s} style={styles.progressRow}>

                  <div style={{ fontWeight: 700 }}>{s}</div>

                  <div style={{ color: styles.muted.color }}>

                    Completed: {c ? "Yes" : "No"} • Time: {fmtMs(t)}

                  </div>

                  <div style={{ fontSize: 12, color: styles.muted.color }}>

                    {sig

                      ? `Micro: ${sig.microSignals?.abstractionPreference || "neutral"}; ${sig.microSignals?.loadHandling || "neutral"} • Flags: ${sig.contradictionFlags || 0}`

                      : "No signals recorded yet."}

                  </div>

                </div>

              );

            })}

          </div>

        </Card>

      </div>

    </div>

  );

}



