                    const v = situationalAnswers?.[selectedSkill]?.[q.id];

                    return (

                      <SituationalQuestion

                        key={q.id}

                        q={q}

                        value={v ?? null}

                        onChange={(nv) => setSituationalAnswer(selectedSkill, q.id, nv)}

                      />

                    );

                  })}



                  <div style={{ display: "flex", gap: 10, flexWrap: "wrap", marginTop: 6 }}>

                    <SecondaryButton onClick={() => setStage(1)}>Back</SecondaryButton>

                    <PrimaryButton

                      onClick={finishAssessment}

                      iconRight={<ArrowRight size={18} />}

                    >

                      Generate Report

                    </PrimaryButton>

                  </div>



                  <div style={{ fontSize: 12, color: styles.muted.color }}>

                    Consistency & contradiction checks are applied non-judgmentally to reduce input gaming and highlight context mismatches.

                  </div>

                </div>

              ) : null}



              {stage === 3 && finalReport ? (

                <ReportView

                  skill={selectedSkill}

                  report={finalReport}

                  contextMode={contextMode}

                  onStartNew={resetAssessment}

                  onExport={exportReport}

                />

              ) : null}

            </Card>

          </div>

        </div>

      )}

    </div>

  );

}



/* -------------------------------------------------------

 * Report View: detailed insights (strength/weakness phrasing)

 * No deterministic language, no labels, no pass/fail

 * ----------------------------------------------------- */



function ReportView({ skill, report, contextMode, onStartNew, onExport }) {

  const derived = report.derivedSignals;

  const flags = report.contradictionFlags || [];

  const perSkill = derived?.perSkill?.[skill];



  const tips = safeTipsForSkill(skill, derived, contextMode);



  return (

    <div style={{ display: "grid", gap: 14 }}>

      <div style={styles.sectionHeader}>

        <div style={styles.sectionTitle}>Final Report • {skill}</div>

        <div style={styles.sectionSub}>

