  const [progress, setProgress] = useState({

    completions: {}, // skill -> { completedAt, stage2AnsweredCount, situationalAnsweredCount }

    timeSpentMs: {}, // skill -> ms

    performanceSignals: {}, // skill -> derived snippets (not raw)

  });



  const timerRef = useRef({ skill: selectedSkill, startedAt: Date.now() });



  // Start timing per skill

  React.useEffect(() => {

