// SAFE INTEGRATION LAYER (Non-breaking)

export type FeatureFlags = {

  firebaseAuth?: boolean;          // Firebase -> auth + profile persistence only (optional)

  geminiInsights?: boolean;        // Gemini -> insight generation only (non-blocking)

  bigQueryAnalytics?: boolean;     // BigQuery -> analytics logging only (async, fire-and-forget)

  vertexInference?: boolean;       // Vertex AI -> model inference only behind abstraction layer

  vertexExplainability?: boolean;  // Vertex Explainable AI -> explanation enrichment only if available

};



// SAFE INTEGRATION LAYER (Non-breaking)

const DEFAULT_FLAGS: Required<FeatureFlags> = {

  firebaseAuth: false,

  geminiInsights: false,

  bigQueryAnalytics: false,

  vertexInference: false,

  vertexExplainability: false,

};



// SAFE INTEGRATION LAYER (Non-breaking)

function getEnv(key: string): string | undefined {

  try {

    const nodeEnv = (globalThis as any)?.process?.env?.[key];

    if (typeof nodeEnv === "string" && nodeEnv.length > 0) return nodeEnv;



    const viteEnv = (globalThis as any)?.import?.meta?.env?.[key];

    if (typeof viteEnv === "string" && viteEnv.length > 0) return viteEnv;



    return undefined;

  } catch {

    return undefined;

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

function resolveFlags(flags?: FeatureFlags): Required<FeatureFlags> {

  return { ...DEFAULT_FLAGS, ...(flags || {}) };

}



// SAFE INTEGRATION LAYER (Non-breaking)

export type FirebaseAuthAdapter = {

  getUid: () => Promise<string | null>;

  upsertUserProfile: (uid: string, profile: Record<string, any>) => Promise<void>;

};



// SAFE INTEGRATION LAYER (Non-breaking)

export async function getFirebaseAuthAdapter(

  flags?: FeatureFlags

): Promise<FirebaseAuthAdapter> {

  const f = resolveFlags(flags);



  const noop: FirebaseAuthAdapter = {

    getUid: async () => null,

    upsertUserProfile: async () => undefined,

  };



  if (!f.firebaseAuth) return noop;



  try {

    const firebaseApp = await import("firebase/app");

    const firebaseAuth = await import("firebase/auth");

    const firebaseFirestore = await import("firebase/firestore");



    const apiKey = getEnv("FIREBASE_API_KEY");

    const authDomain = getEnv("FIREBASE_AUTH_DOMAIN");

    const projectId = getEnv("FIREBASE_PROJECT_ID");



    if (!apiKey || !authDomain || !projectId) return noop;



    const app = firebaseApp.initializeApp({ apiKey, authDomain, projectId });

    const auth = firebaseAuth.getAuth(app);

    const db = firebaseFirestore.getFirestore(app);



    return {

      getUid: async () => {

        try {

          return auth.currentUser?.uid ?? null;

        } catch {

          return null;

        }

      },

      upsertUserProfile: async (uid, profile) => {

        try {

          const ref = firebaseFirestore.doc(db, "users", uid);

          await firebaseFirestore.setDoc(ref, profile, { merge: true });

        } catch {

          // swallow — fail-safe

        }

      },

    };

  } catch {

    return noop;

  }

}



