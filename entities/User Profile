export async function getFirebaseAuthAdapter(): Promise<FirebaseAuthAdapter> {

  if (!getFlag("firebaseAuth")) return {}; // no-op

  try {

    // Lazy import - avoid breaking builds if firebase isn't installed.

    const fb = await import("firebase/app").catch(() => null);

    if (!fb) return {};

    // IMPORTANT: Do not initialize firebase here unless your app already does it.

    // Use existing initialization if present; otherwise stay no-op.

    return {

      // Implementations intentionally empty until wired to existing app init.

      // Keep as no-op to preserve backward compatibility.

    };

  } catch {

    return {};

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// Gemini: insight generation ONLY, non-blocking.

export type GeminiAdapter = {

  generateInsights?: (input: { prompt: string; context?: unknown }) => Promise<string | null>;

};



export async function getGeminiAdapter(): Promise<GeminiAdapter> {

  if (!getFlag("geminiInsights")) return {}; // no-op

  try {

    // Lazy import placeholder. Replace with your Gemini client module if present.

    const mod = await import("./geminiClient").catch(() => null);

    if (!mod?.generateInsights) return {};

    return {

      generateInsights: async (input) => {

        try {

          return await mod.generateInsights(input);

        } catch {

          return null;

        }

      },

    };

  } catch {

    return {};

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// BigQuery: analytics logging ONLY (async, fire-and-forget).

export type BigQueryAdapter = {

  logEvent?: (event: { name: string; payload?: unknown; ts?: number }) => void;

};



export async function getBigQueryAdapter(): Promise<BigQueryAdapter> {

  if (!getFlag("bigQueryAnalytics")) return {}; // no-op

  try {

    const mod = await import("./bigqueryClient").catch(() => null);

    if (!mod?.logEvent) return {};

    return {

      logEvent: (event) => {

        try {

          // Fire-and-forget; must never throw.

          void mod.logEvent({ ...event, ts: event.ts ?? Date.now() });

        } catch {

          // swallow

        }

      },

    };

  } catch {

    return {};

  }

}



