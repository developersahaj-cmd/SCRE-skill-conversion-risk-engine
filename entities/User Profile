2) OPTIONAL SAFE Integration Adapters (Fail-safe)

The following adapters are additive and OPTIONAL. They are designed to never crash the application if services are unavailable.

// SAFE INTEGRATION LAYER (Non-breaking)

// Feature flags are intentionally optional and default to disabled.

export const SCRE_FEATURE_FLAGS = {

  firebaseAuth: false,

  geminiInsights: false,

  bigQueryAnalytics: false,

  vertexInference: false,

  vertexExplainability: false,

} as const;



// SAFE INTEGRATION LAYER (Non-breaking)

// Minimal runtime-safe flag reader; never assumes env vars exist.

export function getFlag<K extends keyof typeof SCRE_FEATURE_FLAGS>(key: K): boolean {

  try {

    // If your app already has a flag system, you can map into it here (optional).

    const v = (globalThis as any)?.SCRE_FLAGS?.[key];

    return typeof v === "boolean" ? v : SCRE_FEATURE_FLAGS[key];

  } catch {

    return SCRE_FEATURE_FLAGS[key];

  }

}



