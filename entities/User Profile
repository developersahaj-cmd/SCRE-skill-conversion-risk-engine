// SAFE INTEGRATION LAYER (Non-breaking)

// Utility: wrap any optional adapter call so it never blocks or crashes core UX.

export async function safeOptional<T>(fn: (() => Promise<T>) | undefined, fallback: T): Promise<T> {

  if (!fn) return fallback;

  try {

    return await fn();

  } catch {

    return fallback;

  }

}

3) Behavioral Neutrality + Conceptual Integrity Notes

These adapters are explicitly non-prescriptive. They must not alter SCRE’s meaning of Skill Conversion Risk or turn outputs into advice. If any external service is missing, outputs must degrade to empty/null/no-op without affecting core behavior.
