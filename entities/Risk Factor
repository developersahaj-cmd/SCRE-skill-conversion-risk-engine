      "type": "string",

      "enum": [

        "technical",

        "organizational",

        "financial",

        "resource",

        "timeline",

        "adoption"

      ],

      "description": "Risk category"

    },

    "factor_name": {

      "type": "string",

      "description": "Name of the risk factor"

    },

    "description": {

      "type": "string",

