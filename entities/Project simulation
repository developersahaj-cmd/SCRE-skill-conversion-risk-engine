{
  "name": "ProjectSimulation",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Associated project ID"
    },
    "simulation_name": {
      "type": "string",
      "description": "Name of the simulation scenario"
    },
    "scenario_type": {
      "type": "string",
      "enum": [
        "budget_cut",
        "timeline_extension",
        "technical_challenge",
        "resource_shortage",
        "scope_change"
      ],
      "description": "Type of hypothetical scenario"
    },
    "input_parameters": {
      "type": "object",
      "description": "Simulation input parameters (budget, timeline, resources, scope, etc.)"
    },
    "original_risk_score": {
      "type": "number",
      "description": "Original project risk score"
    },
    "simulated_risk_score": {
      "type": "number",
      "description": "Risk score after simulation"
    },
    "original_success_rate": {
      "type": "number",
      "description": "Original success rate"
    },
    "simulated_success_rate": {
      "type": "number",
      "description": "Success rate after simulation"
    },
    "impact_analysis": {
      "type": "string",
      "description": "AI-generated impact analysis"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Proactive planning recommendations"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true,
      "description": "Whether generated by AI"
    }
  },
  "required": [
    "project_id",
    "simulation_name",
    "scenario_type"
  ]
}
