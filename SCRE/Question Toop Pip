export default function QuestionTooltip({

  questionId,

  children,

}: {

  questionId: string;

  children: React.ReactNode;

}) {

  const [showTooltip, setShowTooltip] = useState(false);



  const content = tooltipContent[questionId];



  if (!content) return <>{children}</>;



  return (

    <div className="relative">

      <div className="flex items-start justify-between gap-4">

        <div className="flex-1">{children}</div>



        <Button

          type="button"

          size="sm"

          variant="ghost"

          onClick={() => setShowTooltip(true)}

          className="flex-shrink-0 text-slate-400 hover:text-cyan-400 hover:bg-slate-800/80"

          aria-label="Open tooltip"

        >

          <Info className="w-4 h-4" />

        </Button>

      </div>



      <AnimatePresence>

        {showTooltip && (

          <>

            {/* Backdrop */}

            <motion.div

              initial={{ opacity: 0 }}

              animate={{ opacity: 1 }}

              exit={{ opacity: 0 }}

              onClick={() => setShowTooltip(false)}

              className="fixed inset-0 bg-black/60 backdrop-blur-sm z-50"

            />



            {/* Modal */}

            <motion.div

              initial={{ opacity: 0, scale: 0.9, y: 20 }}

              animate={{ opacity: 1, scale: 1, y: 0 }}

              exit={{ opacity: 0, scale: 0.9, y: 20 }}

              className="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg mx-4 z-50"

              role="dialog"

              aria-modal="true"

            >

              <div className="bg-gradient-to-br from-slate-900 to-slate-900/95 border border-cyan-500/30 rounded-lg p-6 shadow-2xl">

                <div className="flex items-start justify-between mb-4">

                  <div className="flex items-center gap-3">

                    <div className="w-10 h-10 rounded-lg bg-cyan-500/20 flex items-center justify-center">

                      <Info className="w-5 h-5 text-cyan-400" />

                    </div>

                    <h3 className="text-xl font-bold text-white">{content.title}</h3>

                  </div>



                  <button

                    type="button"

                    onClick={() => setShowTooltip(false)}

                    className="text-slate-400 hover:text-white transition-colors"

                    aria-label="Close tooltip"

                  >

                    <X className="w-5 h-5" />

                  </button>

                </div>



                <div className="space-y-4">

                  <div>

                    <h4 className="text-sm font-semibold text-cyan-400 mb-1">What this measures</h4>

                    <p className="text-slate-300 text-sm leading-relaxed">{content.explanation}</p>

                  </div>



                  <div>

                    <h4 className="text-sm font-semibold text-cyan-400 mb-1">Why it matters</h4>

                    <p className="text-slate-300 text-sm leading-relaxed">{content.why}</p>

                  </div>



                  {content.scale && (

                    <div className="bg-slate-800/50 rounded-lg p-3">

                      <h4 className="text-xs font-semibold text-slate-400 mb-1">Scale guide</h4>

                      <p className="text-slate-300 text-sm">{content.scale}</p>

                    </div>

                  )}



                  {content.tip && (

                    <div className="bg-slate-800/50 rounded-lg p-3">

                      <h4 className="text-xs font-semibold text-slate-400 mb-1">Tip</h4>

                      <p className="text-slate-300 text-sm">{content.tip}</p>

                    </div>

                  )}

                </div>



                <Button

                  type="button"

                  onClick={() => setShowTooltip(false)}

                  className="w-full mt-6 bg-cyan-600 hover:bg-cyan-700"

                >

                  Got it

                </Button>

              </div>

            </motion.div>

          </>

        )}

      </AnimatePresence>

    </div>

  );

}
