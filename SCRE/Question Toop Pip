

import React, { useState } from 'react';



import { motion, AnimatePresence } from 'framer-motion';

import { Info, X } from 'lucide-react';

import { Button } from '@/components/ui/button';



// SAFE INTEGRATION LAYER (Non-breaking)

// Optional, isolated, fail-safe adapters. Not used by default (no behavioral change).

// - Firebase: auth/profile persistence only (optional)

// - Gemini: insight generation only (non-blocking)

// - BigQuery: analytics logging only (async, fire-and-forget)

// - Vertex AI: model inference only behind abstraction layer

// - Vertex Explainable AI: explanation enrichment only if available

const SCRE_FEATURE_FLAGS = (() => {

  try {

    // Guard everything: never assume env vars exist.

    const g = typeof globalThis !== 'undefined' ? globalThis : {};

    const flags = (g.__SCRE_FLAGS__ || g.SCRE_FLAGS || {}) as Record<string, any>;

    return {

      firebase: Boolean(flags.firebase),

      gemini: Boolean(flags.gemini),

      bigquery: Boolean(flags.bigquery),

      vertex: Boolean(flags.vertex),

      vertexExplain: Boolean(flags.vertexExplain),

    };

  } catch {

    return { firebase: false, gemini: false, bigquery: false, vertex: false, vertexExplain: false };

  }

})();



// SAFE INTEGRATION LAYER (Non-breaking)

const SafeIntegrations = (() => {

  // Local caches for lazy-loaded clients; keep undefined until successfully loaded.

  let _firebase: any;

  let _gemini: any;

  let _bigquery: any;

  let _vertex: any;

  let _vertexExplain: any;



  const noop = {

    async init() {

      return false;

    },

    async logEvent(_eventName: string, _payload?: any) {

      // fire-and-forget no-op

    },

    async generateInsight(_prompt: string, _context?: any) {

      return null; // non-blocking; never throws

    },

    async infer(_input: any) {

      return null; // inference behind abstraction; never throws

    },

    async enrichExplanation(_input: any) {

      return null; // explanation enrichment only if available

    },

  };



  async function lazyImport(modulePath: string) {

    try {

      // Do NOT introduce breaking imports or global side effects: dynamic import only.

      return await import(/* @vite-ignore */ modulePath);

    } catch {

      return null;

    }

  }



  return {

    ...noop,



    // SAFE INTEGRATION LAYER (Non-breaking)

    async init() {

      try {

        // Everything optional and fail-safe.

        // Keep behavior identical if flags are off or modules unavailable.

        if (SCRE_FEATURE_FLAGS.firebase && !_firebase) {

          _firebase = await lazyImport('@/lib/safeFirebaseClient');

        }

        if (SCRE_FEATURE_FLAGS.gemini && !_gemini) {

          _gemini = await lazyImport('@/lib/safeGeminiClient');

        }

        if (SCRE_FEATURE_FLAGS.bigquery && !_bigquery) {

          _bigquery = await lazyImport('@/lib/safeBigQueryClient');

        }

        if (SCRE_FEATURE_FLAGS.vertex && !_vertex) {

          _vertex = await lazyImport('@/lib/safeVertexClient');

        }

        if (SCRE_FEATURE_FLAGS.vertexExplain && !_vertexExplain) {

          _vertexExplain = await lazyImport('@/lib/safeVertexExplainClient');

        }

        return true;

      } catch {

        return false;

      }

    },



    // SAFE INTEGRATION LAYER (Non-breaking)

    async logEvent(eventName: string, payload?: any) {

      try {

        if (!SCRE_FEATURE_FLAGS.bigquery) return;

        // Async fire-and-forget; never blocks UI.

        void (_bigquery?.logEvent?.(eventName, payload));

      } catch {

        // swallow

      }

    },



    // SAFE INTEGRATION LAYER (Non-breaking)

    async generateInsight(prompt: string, context?: any) {

      try {

        if (!SCRE_FEATURE_FLAGS.gemini) return null;

        // Non-blocking: return null on any error.

        return await (_gemini?.generateInsight?.(prompt, context) ?? null);

      } catch {

        return null;

      }

    },



    // SAFE INTEGRATION LAYER (Non-breaking)

    async infer(input: any) {

      try {

        if (!SCRE_FEATURE_FLAGS.vertex) return null;

        return await (_vertex?.infer?.(input) ?? null);

      } catch {

        return null;

      }

    },



    // SAFE INTEGRATION LAYER (Non-breaking)

    async enrichExplanation(input: any) {

      try {

        if (!SCRE_FEATURE_FLAGS.vertexExplain) return null;

        return await (_vertexExplain?.enrichExplanation?.(input) ?? null);

      } catch {

        return null;

      }

    },

  };

})();



