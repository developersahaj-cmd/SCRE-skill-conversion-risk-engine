// SAFE INTEGRATION LAYER (Non-breaking)

// Feature flags are OPTIONAL and default to OFF to preserve current behavior.

const SCRE_FEATURE_FLAGS = {

  firebaseAuth: false, // Firebase → auth, user profile persistence only (optional)

  geminiInsights: false, // Gemini API → insight generation only (non-blocking)

  bigQueryAnalytics: false, // BigQuery → analytics logging only (async, fire-and-forget)

  vertexInference: false, // Vertex AI → model inference only behind abstraction layer

  vertexExplainability: false, // Vertex Explainable AI → explanation enrichment only if available

};



// SAFE INTEGRATION LAYER (Non-breaking)

// Minimal, fail-safe runtime flag reader. Never assumes env vars exist.

function getSafeFlag(flagName, fallback = false) {

  try {

    // Works in Vite, Next, CRA, and plain builds without crashing.

    const env =

      (typeof import.meta !== 'undefined' && import.meta.env) ||

      (typeof process !== 'undefined' && process.env) ||

      {};

    const key = `SCRE_${String(flagName || '').toUpperCase()}`;

    const raw = env?.[key];

    if (raw === undefined || raw === null) return fallback;

    if (typeof raw === 'boolean') return raw;

    const val = String(raw).trim().toLowerCase();

    return val === '1' || val === 'true' || val === 'yes' || val === 'on';

  } catch (e) {

    return fallback;

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// Centralized, safe feature-flag check.

function isFeatureEnabled(flagKey) {

  try {

    const localDefault = Boolean(SCRE_FEATURE_FLAGS?.[flagKey]);

    return getSafeFlag(flagKey, localDefault);

  } catch (e) {

    return false;

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// BigQuery analytics: fire-and-forget, always safe, no-op by default.

async function safeLogAnalyticsEvent(eventName, payload = {}) {

  try {

    if (!isFeatureEnabled('bigQueryAnalytics')) return;



    // Lazy-load: do not import BigQuery SDKs by default.

    // In browser apps, you typically POST to a server endpoint instead of using SDK directly.

    // This is an adapter placeholder and will NEVER throw.

    const endpoint =

      (typeof window !== 'undefined' && window?.__SCRE_BIGQUERY_ENDPOINT__) || null;



    if (!endpoint) return; // No endpoint configured → no-op



    // Fire-and-forget (do not await in calling code).

    fetch(endpoint, {

      method: 'POST',

      headers: { 'Content-Type': 'application/json' },

      keepalive: true,

      body: JSON.stringify({

        eventName,

        payload,

        ts: Date.now(),

      }),

    }).catch(() => {

      // swallow errors

    });

  } catch (e) {

    // swallow errors

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// Gemini: insight generation only, non-blocking, no-op by default.

async function safeGenerateGeminiInsight(_prompt, _context = {}) {

  try {

    if (!isFeatureEnabled('geminiInsights')) return null;



    // Lazy-load: keep optional to avoid breaking builds.

    // Consumers can set window.__SCRE_GEMINI_ADAPTER__ at runtime.

    const adapter =

      (typeof window !== 'undefined' && window?.__SCRE_GEMINI_ADAPTER__) || null;



    if (typeof adapter?.generateInsight === 'function') {

      return await adapter.generateInsight(_prompt, _context);

    }



    // No adapter present → no-op

    return null;

  } catch (e) {

    return null;

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// Vertex AI inference behind abstraction layer only. No-op by default.

async function safeVertexInfer(_modelInput) {

  try {

    if (!isFeatureEnabled('vertexInference')) {

      return { ok: false, output: null, error: null };

    }



    const adapter =

      (typeof window !== 'undefined' && window?.__SCRE_VERTEX_ADAPTER__) || null;



    if (typeof adapter?.infer === 'function') {

      const output = await adapter.infer(_modelInput);

      return { ok: true, output, error: null };

    }



    // No adapter present → mocked empty result

    return { ok: true, output: null, error: null };

  } catch (e) {

    return { ok: false, output: null, error: e };

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// Vertex Explainable AI enrichment only if available. No-op by default.

async function safeVertexExplain(_inferenceOutput, _explainContext = {}) {

  try {

    if (!isFeatureEnabled('vertexExplainability')) return null;



    const adapter =

      (typeof window !== 'undefined' && window?.__SCRE_VERTEX_XAI_ADAPTER__) || null;



    if (typeof adapter?.explain === 'function') {

      return await adapter.explain(_inferenceOutput, _explainContext);

    }



    return null;

  } catch (e) {

    return null;

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// Firebase: auth + profile persistence only (optional). No-op by default.

async function safeEnsureFirebaseAuth() {

  try {

    if (!isFeatureEnabled('firebaseAuth')) {

      return { ok: false, user: null };

    }



    // Lazy-load via runtime adapter or dynamic import; never crashes if missing.

    const adapter =

      (typeof window !== 'undefined' && window?.__SCRE_FIREBASE_ADAPTER__) || null;



    if (typeof adapter?.getUser === 'function') {

      const user = await adapter.getUser();

      return { ok: true, user: user || null };

    }



    // If no adapter is wired, do not attempt imports (keeps builds safe).

    return { ok: true, user: null };

  } catch (e) {

    return { ok: false, user: null };

  }

}



