// SAFE INTEGRATION LAYER (Non-breaking)

// Feature flags are optional and guarded. Defaults to OFF.

function getSCREFlags() {

  try {

    const fromGlobal =

      typeof globalThis !== 'undefined' && globalThis && globalThis.__SCRE_FLAGS__ ? globalThis.__SCRE_FLAGS__ : null;



    const fromProcess =

      typeof process !== 'undefined' && process && process.env ? process.env : null;



    // Least-invasive merge: globals override env, but both are optional.

    return {

      firebaseAuthEnabled: !!(fromGlobal && fromGlobal.firebaseAuthEnabled) || !!(fromProcess && fromProcess.SCRE_FIREBASE_AUTH === 'true'),

      geminiInsightsEnabled: !!(fromGlobal && fromGlobal.geminiInsightsEnabled) || !!(fromProcess && fromProcess.SCRE_GEMINI_INSIGHTS === 'true'),

      bigqueryLoggingEnabled: !!(fromGlobal && fromGlobal.bigqueryLoggingEnabled) || !!(fromProcess && fromProcess.SCRE_BIGQUERY_LOGGING === 'true'),

      vertexInferenceEnabled: !!(fromGlobal && fromGlobal.vertexInferenceEnabled) || !!(fromProcess && fromProcess.SCRE_VERTEX_INFERENCE === 'true'),

      vertexExplainEnabled: !!(fromGlobal && fromGlobal.vertexExplainEnabled) || !!(fromProcess && fromProcess.SCRE_VERTEX_EXPLAIN === 'true'),

    };

  } catch (e) {

    return {

      firebaseAuthEnabled: false,

      geminiInsightsEnabled: false,

      bigqueryLoggingEnabled: false,

      vertexInferenceEnabled: false,

      vertexExplainEnabled: false,

    };

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// No-op + lazy loaders. Never throw; never block render.

const SCREIntegrations = (() => {

  const flags = getSCREFlags();



  const noop = {

    init: async () => {},

    logEvent: async () => {},

    getInsight: async () => null,

    infer: async () => null,

    explain: async () => null,

  };



  // SAFE INTEGRATION LAYER (Non-breaking)

  async function lazyImport(moduleName) {

    try {

      // Intentionally dynamic and guarded. If bundler or module missing, return null.

      return await import(/* webpackIgnore: true */ moduleName);

    } catch (e) {

      return null;

    }

  }



  // SAFE INTEGRATION LAYER (Non-breaking)

  async function getBigQueryLogger() {

    if (!flags.bigqueryLoggingEnabled) return noop;



    try {

      // You may replace this module path with your internal adapter at build-time.

      // Keeping it optional ensures backward compatibility.

      const mod = await lazyImport('scre/bigqueryLogger');

      return mod && mod.default ? mod.default : noop;

    } catch (e) {

      return noop;

    }

  }



  // SAFE INTEGRATION LAYER (Non-breaking)

  async function getGeminiInsights() {

    if (!flags.geminiInsightsEnabled) return noop;



    try {

      const mod = await lazyImport('scre/geminiInsights');

      return mod && mod.default ? mod.default : noop;

    } catch (e) {

      return noop;

    }

  }



  // SAFE INTEGRATION LAYER (Non-breaking)

  async function getVertexInference() {

    if (!flags.vertexInferenceEnabled) return noop;



    try {

      const mod = await lazyImport('scre/vertexInference');

      return mod && mod.default ? mod.default : noop;

    } catch (e) {

      return noop;

    }

  }



  // SAFE INTEGRATION LAYER (Non-breaking)

  async function getVertexExplain() {

    if (!flags.vertexExplainEnabled) return noop;



    try {

      const mod = await lazyImport('scre/vertexExplain');

      return mod && mod.default ? mod.default : noop;

    } catch (e) {

      return noop;

    }

  }



  // SAFE INTEGRATION LAYER (Non-breaking)

  async function getFirebaseAuth() {

    if (!flags.firebaseAuthEnabled) return noop;



    try {

      const mod = await lazyImport('scre/firebaseAuth');

      return mod && mod.default ? mod.default : noop;

    } catch (e) {

      return noop;

    }

  }



  return {

    flags,

    getBigQueryLogger,

    getGeminiInsights,

    getVertexInference,

    getVertexExplain,

    getFirebaseAuth,

  };

})();



// SAFE INTEGRATION LAYER (Non-breaking)

// Fire-and-forget logging that never blocks navigation.

async function safeLogResourceClick(payload) {

  try {

    const logger = await SCREIntegrations.getBigQueryLogger();

    // best-effort, async

    await logger.logEvent?.('resource_click', payload);

  } catch (e) {

    // intentionally swallow errors

  }

}



