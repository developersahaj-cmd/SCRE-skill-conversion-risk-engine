import React, { useState, useEffect } from "react";



import { base44 } from "@/api/base44Client";



import { useMutation, useQueryClient } from "@tanstack/react-query";

import { Link, useNavigate } from "react-router-dom";

import { createPageUrl } from "@/utils";



import { Button } from "@/components/ui/button";

import { Input } from "@/components/ui/input";

import { Label } from "@/components/ui/label";

import { Textarea } from "@/components/ui/textarea";

import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

import { Avatar, AvatarFallback } from "@/components/ui/avatar";



import {

  Mail,

  Briefcase,

  MapPin,

  Phone,

  Save,

  Logout,

  ArrowLeft,

  User,

} from "lucide-react";



import { motion } from "framer-motion";

import { Switch } from "@/components/ui/switch";



// SAFE INTEGRATION LAYER (Non-breaking)

// Feature flags are OPTIONAL and guarded. No env assumptions.

// You can enable via window.__SCRE_FEATURES__ = { firebase: true, gemini: true, bigquery: true, vertex: true }

const SAFE_FEATURES = (() => {

  try {

    const w = typeof window !== "undefined" ? window : undefined;

    const flags = w && w.__SCRE_FEATURES__ ? w.__SCRE_FEATURES__ : {};

    return {

      firebase: !!flags.firebase,

      gemini: !!flags.gemini,

      bigquery: !!flags.bigquery,

      vertex: !!flags.vertex,

      vertexExplain: !!flags.vertexExplain,

    };

  } catch (_e) {

    return {

      firebase: false,

      gemini: false,

      bigquery: false,

      vertex: false,

      vertexExplain: false,

    };

  }

})();



// SAFE INTEGRATION LAYER (Non-breaking)

// No-op adapters: if services unavailable, return empty results and never throw.

const SafeNoop = {

  async init() {

    return true;

  },

  async trackEvent(_eventName, _payload) {

    return;

  },

  async generateInsights(_input) {

    return { text: "", metadata: {} };

  },

  async infer(_input) {

    return { result: null, raw: null };

  },

  async explain(_input) {

    return { factors: [], raw: null };

  },

};



// SAFE INTEGRATION LAYER (Non-breaking)

// Lazy loaders wrapped in try/catch; never crash the app.

async function lazyLoadFirebase() {

  try {

    if (!SAFE_FEATURES.firebase) return SafeNoop;

    // NOTE: Optional only. Do not introduce breaking imports.

    // Expectation: app can provide a module at this path, otherwise no-op.

    const mod = await import(/* webpackChunkName: "firebaseAdapter" */ "@/integrations/firebaseAdapter").catch(

      () => null

    );

    return mod && mod.default ? mod.default : SafeNoop;

  } catch (_e) {

    return SafeNoop;

  }

}



async function lazyLoadGemini() {

  try {

    if (!SAFE_FEATURES.gemini) return SafeNoop;

    const mod = await import(/* webpackChunkName: "geminiAdapter" */ "@/integrations/geminiAdapter").catch(

      () => null

    );

    return mod && mod.default ? mod.default : SafeNoop;

  } catch (_e) {

    return SafeNoop;

  }

}



