async function lazyLoadVertexAI() {

  try {

    if (!SAFE_FEATURES.vertex) return SafeNoop;

    const mod = await import(/* webpackChunkName: "vertexAdapter" */ "@/integrations/vertexAdapter").catch(

      () => null

    );

    return mod && mod.default ? mod.default : SafeNoop;

