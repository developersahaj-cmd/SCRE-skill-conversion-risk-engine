}



async function lazyLoadVertexExplainableAI() {

  try {

    if (!SAFE_FEATURES.vertexExplain) return SafeNoop;

    const mod = await import(

      /* webpackChunkName: "vertexExplainAdapter" */ "@/integrations/vertexExplainAdapter"

    ).catch(() => null);

    return mod && mod.default ? mod.default : SafeNoop;

  } catch (_e) {

    return SafeNoop;

  }

}



export default function Profile() {

  const [user, setUser] = useState(null);

  const [profile, setProfile] = useState(null);

  const [isEditing, setIsEditing] = useState(false);



  const navigate = useNavigate();

  const queryClient = useQueryClient();



  useEffect(() => {

    const loadUser = async () => {

      try {

        // Existing behavior preserved: load current user via base44.

        const currentUser = await base44.auth.me();

        setUser(currentUser);



        // Existing intent preserved: fetch profile by user email.

        const profiles = await base44.entities.UserProfile.filter({

          user_email: currentUser.email,

        });



        if (profiles && profiles.length > 0) {

          setProfile(profiles[0]);

        } else {

          // Create default profile (same fields as original snippet).

          const newProfile = await base44.entities.UserProfile.create({

            user_email: currentUser.email,

            notification_preferences: {

              email_notifications: true,

              high_risk_alerts: true,

              weekly_reports: false,

            },

          });

          setProfile(newProfile);

        }



        // SAFE INTEGRATION LAYER (Non-breaking)

        // Fire-and-forget analytics only. Never blocks UI; never throws.

        (async () => {

          try {

            const bq = await lazyLoadBigQuery();

            await bq.trackEvent("profile_loaded", {

              user_email: currentUser && currentUser.email ? currentUser.email : "",

              ts: Date.now(),

            });

          } catch (_e) {

            // no-op

          }

        })();



        // SAFE INTEGRATION LAYER (Non-breaking)

        // Optional insight generation only (non-blocking). Does not alter UX.

        (async () => {

          try {

            const gemini = await lazyLoadGemini();

            await gemini.generateInsights({

              kind: "profile_context",

              user_email: currentUser && currentUser.email ? currentUser.email : "",

            });

          } catch (_e) {

            // no-op

          }

        })();

      } catch (error) {

        // Least-invasive: keep app stable and route away if needed.

        console.error("Profile load error:", error);

        try {

          navigate(createPageUrl("Home"));

        } catch (_e) {

          // fallback navigation

          window.location.href = "/#" + createPageUrl("Home");

        }

      }

    };



    loadUser();

  }, [navigate]);



  const updateProfileMutation = useMutation({

    mutationFn: (data) => base44.entities.UserProfile.update(profile.id, data),

    onSuccess: (updatedProfile) => {

      setProfile(updatedProfile);

      setIsEditing(false);



      // SAFE INTEGRATION LAYER (Non-breaking)

      // Async analytics logging only.

      (async () => {

        try {

          const bq = await lazyLoadBigQuery();

          await bq.trackEvent("profile_saved", {

            user_email: user && user.email ? user.email : "",

            ts: Date.now(),

          });

        } catch (_e) {

          // no-op

        }

      })();



      // (Optional) keep cache coherent if app uses query keys; no breaking assumptions.

      try {

        queryClient.invalidateQueries();

      } catch (_e) {

        // no-op

      }

    },

  });



  const handleSave = () => {

    try {

      updateProfileMutation.mutate(profile);

    } catch (e) {

      console.error("Save error:", e);

    }

  };



  const handleLogout = async () => {

    try {

      // Clear any local state

      setUser(null);

      setProfile(null);



      // SAFE INTEGRATION LAYER (Non-breaking)

      // Optional: sign out of Firebase if enabled (never blocks base44 logout).

      (async () => {

        try {

          const fb = await lazyLoadFirebase();

          // Expected adapter signature; no-op if absent.

          if (fb && typeof fb.signOut === "function") await fb.signOut();

        } catch (_e) {

          // no-op

        }

      })();



      // Logout and redirect to home.

      await base44.auth.logout(window.location.origin + "/#" + createPageUrl("Home"));

    } catch (error) {

      console.error("Logout error:", error);



      // Force redirect even if error

      window.location.href = "/#" + createPageUrl("Home");

    }

  };



  if (!user || !profile) {

    return (

      <div className="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 flex items-center justify-center">

        <div className="text-slate-600">Loading profile...</div>

      </div>

    );

  }



  const initials =

    user.full_name

      ?.split(" ")

      .filter(Boolean)

      .map((n) => n[0])

      .join("")

      .toUpperCase() || (user.email ? user.email[0].toUpperCase() : "U");



  return (

    <div className="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 p-6">

      <div className="max-w-4xl mx-auto space-y-6">

        <Link to={createPageUrl("Home")}>

          <Button variant="ghost" className="mb-2">

            <ArrowLeft className="w-4 h-4 mr-2" />

            Back to Home

          </Button>

        </Link>



        <motion.div initial={{ opacity: 0, y: -20 }} animate={{ opacity: 1, y: 0 }}>

          <div className="flex items-center justify-between">

            <h1 className="text-4xl font-bold text-slate-900">Profile Settings</h1>



            <Button

              onClick={handleLogout}

              variant="outline"

              className="border-red-300 text-red-600 hover:bg-red-50"

            >

              <Logout className="w-4 h-4 mr-2" />

              Sign Out

            </Button>

          </div>

        </motion.div>



        {/* Profile Overview */}

        <Card className="border-slate-200">

          <CardContent className="p-6">

            <div className="flex items-center space-x-4">

              <Avatar className="h-16 w-16">

                <AvatarFallback className="bg-emerald-100 text-emerald-700 text-lg font-semibold">

                  {initials}

                </AvatarFallback>

              </Avatar>



              <div className="flex-1">

                <h2 className="text-2xl font-bold text-slate-900 flex items-center">

                  <User className="w-5 h-5 mr-2 text-slate-500" />

                  {user.full_name || "User"}

                </h2>

                <p className="text-slate-600 flex items-center mt-1">

                  <Mail className="w-4 h-4 mr-2 text-slate-500" />

                  {user.email}

                </p>

              </div>



              <div className="flex flex-col gap-2">

                <Button

                  variant={isEditing ? "secondary" : "outline"}

                  onClick={() => setIsEditing(!isEditing)}

                >

                  {isEditing ? "Cancel" : "Edit"}

                </Button>



                <Button

                  onClick={handleSave}

                  className="bg-emerald-600 hover:bg-emerald-700 text-white"

                  disabled={!isEditing}

                >

                  <Save className="w-4 h-4 mr-2" />

                  Save

                </Button>

              </div>

            </div>

          </CardContent>

        </Card>



        {/* Profile Details */}

        <Card className="border-slate-200">

          <CardHeader>

            <CardTitle>Professional Information</CardTitle>

          </CardHeader>



          <CardContent className="space-y-4">

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">

              <div>

                <Label className="flex items-center mb-2">

                  <Briefcase className="w-4 h-4 mr-2 text-slate-500" />

                  Job Title

                </Label>



                <Input

                  value={profile.job_title || ""}

                  onChange={(e) => setProfile({ ...profile, job_title: e.target.value })}

                  disabled={!isEditing}

                  placeholder="e.g., Senior Risk Analyst"

                />

              </div>



              <div>

                <Label className="flex items-center mb-2">

                  <Briefcase className="w-4 h-4 mr-2 text-slate-500" />

                  Department

                </Label>



                <Input

                  value={profile.department || ""}

                  onChange={(e) => setProfile({ ...profile, department: e.target.value })}

                  disabled={!isEditing}

                  placeholder="e.g., Engineering"

                />

              </div>



              <div>

                <Label className="flex items-center mb-2">

                  <Phone className="w-4 h-4 mr-2 text-slate-500" />

                  Phone

                </Label>



                <Input

                  value={profile.phone || ""}

                  onChange={(e) => setProfile({ ...profile, phone: e.target.value })}

                  disabled={!isEditing}

                  placeholder="+1 (555) 000-0000"

                />

              </div>



              <div>

                <Label className="flex items-center mb-2">

                  <MapPin className="w-4 h-4 mr-2 text-slate-500" />

                  Location

                </Label>



                <Input

                  value={profile.location || ""}

                  onChange={(e) => setProfile({ ...profile, location: e.target.value })}

                  disabled={!isEditing}

                  placeholder="e.g., San Francisco, CA"

                />

              </div>

            </div>



            <div>

              <Label className="mb-2">Bio</Label>

              <Textarea

                value={profile.bio || ""}

                onChange={(e) => setProfile({ ...profile, bio: e.target.value })}

                disabled={!isEditing}

                placeholder="Tell us about yourself and your expertise..."

                rows={4}

              />

            </div>

          </CardContent>

        </Card>



        {/* Notification Preferences */}

        <Card className="border-slate-200">

          <CardHeader>

            <CardTitle>Notification Preferences</CardTitle>

          </CardHeader>



          <CardContent className="space-y-4">

            <div className="flex items-center justify-between">

              <div>

                <p className="font-medium text-slate-900">Email Notifications</p>

                <p className="text-sm text-slate-600">Receive updates via email</p>

              </div>



              <Switch

                checked={!!profile.notification_preferences?.email_notifications}

                onCheckedChange={(checked) =>

                  setProfile({

                    ...profile,

                    notification_preferences: {

                      ...(profile.notification_preferences || {}),

                      email_notifications: checked,

                    },

                  })

                }

                disabled={!isEditing}

              />

            </div>



            <div className="flex items-center justify-between">

              <div>

                <p className="font-medium text-slate-900">High Risk Alerts</p>

                <p className="text-sm text-slate-600">Get notified about critical risks</p>

              </div>



              <Switch

                checked={!!profile.notification_preferences?.high_risk_alerts}

                onCheckedChange={(checked) =>

                  setProfile({

                    ...profile,

                    notification_preferences: {

                      ...(profile.notification_preferences || {}),

                      high_risk_alerts: checked,

                    },

                  })

                }

                disabled={!isEditing}

              />

            </div>



            <div className="flex items-center justify-between">

              <div>

                <p className="font-medium text-slate-900">Weekly Reports</p>

                <p className="text-sm text-slate-600">Receive weekly summary reports</p>

              </div>



              <Switch

                checked={!!profile.notification_preferences?.weekly_reports}

                onCheckedChange={(checked) =>

                  setProfile({

                    ...profile,

                    notification_preferences: {

                      ...(profile.notification_preferences || {}),

                      weekly_reports: checked,

                    },

                  })

                }

                disabled={!isEditing}

              />

            </div>



            {isEditing && (

              <Button

                onClick={handleSave}

                className="w-full bg-emerald-600 hover:bg-emerald-700 text-white"

              >

                <Save className="w-4 h-4 mr-2" />

                Save Preferences

              </Button>

            )}

          </CardContent>

        </Card>

      </div>

    </div>

  );

}



