import React from "react";

import { base44 } from "@/api/base44Client";

import { useQuery } from "@tanstack/react-query";

import { Link } from "react-router-dom";

import { createPageUrl } from "@/utils";

import { Button } from "@/components/ui/button";

import MetricCard from "../components/dashboard/MetricCard";

import RiskChart from "../components/dashboard/RiskChart";

import TrendChart from "../components/dashboard/TrendChart";

import {

  BarChart3,

  AlertTriangle,

  TrendingUp,

  Users,

  Briefcase,

  Target,

  ArrowLeft,

} from "lucide-react";

import { motion } from "framer-motion";



/**

 * GLOBAL STABILITY PROMPT applied:

 * - Fixes JSX/logic syntax issues.

 * - Preserves existing visual semantics (low/medium/high and critical bands are untouched).

 * - Charts continue to work with zero-data fallbacks (no external data sources required).

 * - No changes to how "risk" is computed vs the original intent (only syntax/structure fixes).

 */



export default function Dashboard() {

  // Projects

  const {

    data: projects = [],

    isLoading: isProjectsLoading,

    isError: isProjectsError,

  } = useQuery({

    queryKey: ["projects"],

    queryFn: () => base44.entities.SkillConversionProject.list(),

  });



  // Risk factors

  const {

    data: riskFactors = [],

    isLoading: isRiskFactorsLoading,

    isError: isRiskFactorsError,

  } = useQuery({

    queryKey: ["riskFactors"],

    queryFn: () => base44.entities.RiskFactor.list(),

  });



  const isLoading = isProjectsLoading || isRiskFactorsLoading;



  // Calculate metrics (same intent as original)

  const totalProjects = projects.length;



  const atRiskProjects = projects.filter(

    (p) => p.status === "at_risk" || p.risk_level === "critical"

  ).length;



  const avgSuccessRate =

    projects.length > 0

      ? Math.round(

          projects.reduce(

            (acc, p) => acc + (p.conversion_success_rate || 0),

            0

          ) / projects.length

        )

      : 0;



  const totalEmployees = projects.reduce(

    (acc, p) => acc + (p.employees_affected || 0),

    0

  );



  // Risk distribution data (robust even when riskFactors=[])

  const categories = ["technical", "organizational", "financial", "timeline"];

  const labelByCategory = {

    technical: "Technical",

    organizational: "Organizational",

    financial: "Financial",

    timeline: "Timeline",

  };



  const countBy = (category, severity) =>

    riskFactors.filter(

      (r) => r.category === category && r.severity === severity

    ).length;



  const riskDistribution = categories.map((cat) => ({

    name: labelByCategory[cat] ?? cat,

    critical: countBy(cat, "critical"),

    high: countBy(cat, "high"),

    medium: countBy(cat, "medium"),

    low: countBy(cat, "low"),

  }));



  // Trend data (local fallback; charts work even if no historical source exists)

  const trendData = [

    { month: "Jan", riskScore: 65, successRate: 72 },

    { month: "Feb", riskScore: 62, successRate: 75 },

    { month: "Mar", riskScore: 58, successRate: 78 },

    { month: "Apr", riskScore: 55, successRate: 82 },

    { month: "May", riskScore: 52, successRate: 85 },

    { month: "Jun", riskScore: 48, successRate: 88 },

  ];



  if (isLoading) {

    return (

      <div className="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 flex items-center justify-center">

        <div className="text-slate-600">Loading dashboard...</div>

      </div>

    );

  }



  // Non-blocking error handling (keeps UI stable)

  const hasError = isProjectsError || isRiskFactorsError;



  return (

    <div className="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 p-6">

      <div className="max-w-7xl mx-auto space-y-8">

        <Link to={createPageUrl("Home")}>

          <Button variant="ghost" className="mb-2">

            <ArrowLeft className="w-4 h-4 mr-2" />

            Back to Home

          </Button>

        </Link>



        {/* Header */}

        <motion.div

          initial={{ opacity: 0, y: -20 }}

          animate={{ opacity: 1, y: 0 }}

        >

          <div className="flex items-start justify-between gap-4">

            <div>

              <h1 className="text-4xl font-bold text-slate-900 mb-2">

                Risk Analytics Dashboard

              </h1>

              <p className="text-slate-600">

                Real-time insights into your skill conversion projects

              </p>

            </div>



            <div className="hidden md:flex items-center gap-2 text-slate-500">

              <BarChart3 className="w-5 h-5" />

              <span className="text-sm">Analytics</span>

            </div>

          </div>



          {hasError ? (

            <div className="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">

              Some data failed to load. Showing available information with local

              fallbacks.

            </div>

          ) : null}

        </motion.div>



        {/* Metric Cards */}

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

          <MetricCard

            title="Total Projects"

            value={totalProjects}

            subtitle="Active conversions"

            icon={Briefcase}

            color="blue"

            trend={12}

          />



          <MetricCard

            title="At Risk Projects"

            value={atRiskProjects}

            subtitle="Requiring attention"

            icon={AlertTriangle}

            color="red"

            trend={-5}

          />



          <MetricCard

            title="Avg Success Rate"

            value={`${avgSuccessRate}%`}

            subtitle="Across all projects"

            icon={Target}

            color="emerald"

            trend={8}

          />



          <MetricCard

            title="Total Employees"

            value={totalEmployees}

            subtitle="Undergoing conversion"

            icon={Users}

            color="purple"

            trend={15}

          />

        </div>



        {/* Charts */}

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">

          <RiskChart

            data={riskDistribution}

            title="Risk Factor Distribution by Category"

          />



          <TrendChart

            data={trendData}

            title="Risk Score & Success Rate Trends"

          />

        </div>



        {/* Quick Actions */}

        <motion.div

          initial={{ opacity: 0 }}

          animate={{ opacity: 1 }}

          transition={{ delay: 0.3 }}

          className="bg-white rounded-xl shadow-sm border border-slate-200 p-6"

        >

          <h2 className="text-lg font-semibold text-slate-900 mb-4">

            Quick Insights

          </h2>



          <div className="space-y-3">

            <div className="flex items-center justify-between p-3 bg-amber-50 rounded-lg">

              <div className="flex items-center">

                <AlertTriangle className="w-5 h-5 text-amber-600 mr-3" />

                <span className="text-sm text-slate-700">

                  {atRiskProjects} projects need immediate attention

                </span>

              </div>

              <span className="text-xs text-amber-600 font-medium">

                High Priority

              </span>

            </div>



            <div className="flex items-center justify-between p-3 bg-emerald-50 rounded-lg">

              <div className="flex items-center">

                <TrendingUp className="w-5 h-5 text-emerald-600 mr-3" />

                <span className="text-sm text-slate-700">

                  Success rates improved by 8% this quarter

                </span>

              </div>

              <span className="text-xs text-emerald-600 font-medium">

                Trending Up

              </span>

            </div>

          </div>

        </motion.div>

      </div>

    </div>

  );

}
