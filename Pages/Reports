import React, { useMemo, useState } from "react";



import { base44 } from "@/api/base44Client";



import { useQuery } from "@tanstack/react-query";



import { Link } from "react-router-dom";



import { createPageUrl } from "@/utils";



import { Button } from "@/components/ui/button";



import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";



import {

  Select,

  SelectContent,

  SelectItem,

  SelectTrigger,

  SelectValue,

} from "@/components/ui/select";



import { Label } from "@/components/ui/label";



import { FileDown, FileText, ArrowLeft } from "lucide-react";



import { motion } from "framer-motion";



import { format } from "date-fns";



// SAFE INTEGRATION LAYER (Non-breaking)

// Optional feature flags with zero global side effects. If unavailable, defaults to all disabled.

const SCRE_FEATURES =

  (typeof window !== "undefined" && window.__SCRE_FEATURES__) || {

    firebaseAuth: false,

    firebaseProfile: false,

    geminiInsights: false,

    bigQueryAnalytics: false,

    vertexInference: false,

    vertexExplain: false,

  };



// SAFE INTEGRATION LAYER (Non-breaking)

// Lazy, fail-safe loader helper. Never throws.

async function safeLazyImport(importer) {

  try {

    if (typeof importer !== "function") return null;

    const mod = await importer();

    return mod || null;

  } catch (e) {

    return null;

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

// Firebase adapters (auth + profile only). No-op by default. Never blocks UI.

const FirebaseAdapter = (() => {

  const noop = {

    isEnabled: false,

    getUser: async () => null,

    persistUserProfile: async () => null,

  };



  if (!SCRE_FEATURES.firebaseAuth && !SCRE_FEATURES.firebaseProfile) return noop;



  return {

    isEnabled: true,

    getUser: async () => {

      try {

        const mod = await safeLazyImport(() => import("@/integrations/firebase"));

        if (!mod || typeof mod.getCurrentUser !== "function") return null;

        return await mod.getCurrentUser();

      } catch (e) {

        return null;

      }

    },

    persistUserProfile: async (profile) => {

      try {

        if (!SCRE_FEATURES.firebaseProfile) return null;

        const mod = await safeLazyImport(() => import("@/integrations/firebase"));

        if (!mod || typeof mod.persistUserProfile !== "function") return null;

        return await mod.persistUserProfile(profile);

      } catch (e) {

        return null;

      }

    },

  };

})();



// SAFE INTEGRATION LAYER (Non-breaking)

// Gemini adapter (insight generation only). No-op by default. Never blocks exports.

const GeminiAdapter = (() => {

  const noop = {

    isEnabled: false,

    generateInsights: async () => ({ insights: [], warnings: [] }),

  };



  if (!SCRE_FEATURES.geminiInsights) return noop;



  return {

    isEnabled: true,

    generateInsights: async (input) => {

      try {

        const mod = await safeLazyImport(() => import("@/integrations/gemini"));

        if (!mod || typeof mod.generateInsights !== "function") {

          return { insights: [], warnings: ["Gemini unavailable"] };

        }

        // Must be non-blocking for UX: still safe if caller awaits.

        return (await mod.generateInsights(input)) || { insights: [], warnings: [] };

      } catch (e) {

        return { insights: [], warnings: ["Gemini failed"] };

      }

    },

  };

})();



// SAFE INTEGRATION LAYER (Non-breaking)

// BigQuery adapter (analytics logging only). Fire-and-forget; never throws.

const BigQueryAdapter = (() => {

  const noop = {

    isEnabled: false,

    logEvent: () => {},

  };



  if (!SCRE_FEATURES.bigQueryAnalytics) return noop;



  return {

    isEnabled: true,

    logEvent: (eventName, payload) => {

      try {

        void (async () => {

          const mod = await safeLazyImport(() => import("@/integrations/bigquery"));

          if (!mod || typeof mod.logEvent !== "function") return;

          try {

            await mod.logEvent(eventName, payload);

          } catch (e) {

            // swallow

          }

        })();

      } catch (e) {

        // swallow

      }

    },

  };

})();



// SAFE INTEGRATION LAYER (Non-breaking)

// Vertex adapters (model inference + explainability enrichment only). Always optional.

const VertexAdapter = (() => {

  const noop = {

    isEnabled: false,

    infer: async () => null,

    explain: async () => null,

  };



  if (!SCRE_FEATURES.vertexInference && !SCRE_FEATURES.vertexExplain) return noop;



  return {

    isEnabled: true,

    infer: async (input) => {

      try {

        if (!SCRE_FEATURES.vertexInference) return null;

        const mod = await safeLazyImport(() => import("@/integrations/vertex"));

        if (!mod || typeof mod.infer !== "function") return null;

        return await mod.infer(input);

      } catch (e) {

        return null;

      }

    },

    explain: async (input) => {

      try {

        if (!SCRE_FEATURES.vertexExplain) return null;

        const mod = await safeLazyImport(() => import("@/integrations/vertexExplain"));

        if (!mod || typeof mod.explain !== "function") return null;

        return await mod.explain(input);

      } catch (e) {

        return null;

      }

    },

  };

})();



export default function Reports() {

  const [selectedDepartment, setSelectedDepartment] = useState("all");

  const [selectedRiskLevel, setSelectedRiskLevel] = useState("all");

  const [reportType, setReportType] = useState("summary");



  const { data: projects = [] } = useQuery({

    queryKey: ["projects"],

    queryFn: () => base44.entities.SkillConversionProject.list(),

  });



  const { data: riskFactors = [] } = useQuery({

    queryKey: ["riskFactors"],

    queryFn: () => base44.entities.RiskFactor.list(),

  });



  const filteredProjects = useMemo(() => {

    return projects.filter((p) => {

      const deptMatch =

        selectedDepartment === "all" || p.department === selectedDepartment;

      const riskMatch =

        selectedRiskLevel === "all" || p.risk_level === selectedRiskLevel;

      return deptMatch && riskMatch;

    });

  }, [projects, selectedDepartment, selectedRiskLevel]);



  const safeAvgSuccessRate = useMemo(() => {

    if (!filteredProjects.length) return 0;

    const total = filteredProjects.reduce(

      (acc, p) => acc + (p.conversion_success_rate || 0),

      0

    );

    return Math.round(total / filteredProjects.length);

  }, [filteredProjects]);



  const generateCSV = () => {

    try {

      const headers = [

        "Project Name",

        "Department",

        "Source Skill",

        "Target Skill",

        "Status",

        "Risk Level",

        "Risk Score",

        "Success Rate",

        "Employees Affected",

        "Created Date",

      ];



      const rows = filteredProjects.map((p) => [

        p.project_name,

        p.department,

        p.source_skill,

        p.target_skill,

        p.status,

        p.risk_level,

        p.risk_score || 0,

        p.conversion_success_rate || 0,

        p.employees_affected || 0,

        p.created_date ? format(new Date(p.created_date), "yyyy-MM-dd") : "",

      ]);



      const csvContent = [

        headers.join(","),

        ...rows.map((row) =>

          row.map((cell) => `"${String(cell ?? "").replace(/"/g, '""')}"`).join(",")

        ),

      ].join("\n");



      const blob = new Blob([csvContent], { type: "text/csv" });

      const url = window.URL.createObjectURL(blob);



      const a = document.createElement("a");

      a.href = url;

      a.download = `scre-report-${format(new Date(), "yyyy-MM-dd")}.csv`;

      a.click();



      window.URL.revokeObjectURL(url);



      // SAFE INTEGRATION LAYER (Non-breaking)

      // Fire-and-forget analytics only; never blocks.

      BigQueryAdapter.logEvent("reports_export_csv", {

        reportType,

        selectedDepartment,

        selectedRiskLevel,

        count: filteredProjects.length,

        ts: new Date().toISOString(),

      });

    } catch (e) {

      // Fail-safe: do nothing. Export is best-effort.

    }

  };



  const generatePDFContent = () => {

    try {

      const atRiskCount = filteredProjects.filter(

        (p) => p.risk_level === "high" || p.risk_level === "critical"

      ).length;



      const content = `SKILL CONVERSION RISK ENGINE REPORT



Generated: ${format(new Date(), "PPpp")}



REPORT TYPE: ${String(reportType).toUpperCase()}



SUMMARY

=======

Total Projects: ${filteredProjects.length}

At Risk Projects: ${atRiskCount}

Average Success Rate: ${safeAvgSuccessRate}%



PROJECT DETAILS

${filteredProjects

  .map(

    (p) => `

Project: ${p.project_name}

Department: ${p.department}

Conversion: ${p.source_skill} → ${p.target_skill}

Risk Level: ${String(p.risk_level || "").toUpperCase()}

Status: ${p.status}

Employees Affected: ${p.employees_affected || 0}

`

  )

  .join("\n")}



RISK FACTOR SUMMARY

Total Risk Factors: ${riskFactors.length}

Critical: ${riskFactors.filter((r) => r.severity === "critical").length}

High: ${riskFactors.filter((r) => r.severity === "high").length}

Medium: ${riskFactors.filter((r) => r.severity === "medium").length}

Low: ${riskFactors.filter((r) => r.severity === "low").length}

`;



      const blob = new Blob([content], { type: "text/plain" });

      const url = window.URL.createObjectURL(blob);



      const a = document.createElement("a");

      a.href = url;

      a.download = `scre-report-${format(new Date(), "yyyy-MM-dd")}.txt`;

      a.click();



      window.URL.revokeObjectURL(url);



      // SAFE INTEGRATION LAYER (Non-breaking)

      // Non-blocking insight generation (optional). If it fails, nothing happens.

      void (async () => {

        if (!GeminiAdapter.isEnabled) return;

        try {

          await GeminiAdapter.generateInsights({

            reportType,

            filters: { selectedDepartment, selectedRiskLevel },

            summary: {

              totalProjects: filteredProjects.length,

              atRiskCount,

              avgSuccessRate: safeAvgSuccessRate,

            },

          });

        } catch (e) {

          // swallow

        }

      })();



      // SAFE INTEGRATION LAYER (Non-breaking)

      BigQueryAdapter.logEvent("reports_export_text", {

        reportType,

        selectedDepartment,

        selectedRiskLevel,

        count: filteredProjects.length,

        ts: new Date().toISOString(),

      });

    } catch (e) {

      // Fail-safe: do nothing. Export is best-effort.

    }

  };



  return (

    <div className="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 p-6">

      <div className="max-w-5xl mx-auto space-y-6">

        <Link to={createPageUrl("Home")}>

          <Button variant="ghost" className="mb-2">

            <ArrowLeft className="w-4 h-4 mr-2" />

            Back to Home

          </Button>

        </Link>



        <motion.div

          initial={{ opacity: 0, y: -20 }}

          animate={{ opacity: 1, y: 0 }}

        >

          <h1 className="text-4xl font-bold text-slate-900 mb-2">

            Report Generator

          </h1>



          <p className="text-slate-600">

            Create customizable reports for stakeholder communication

          </p>

        </motion.div>



        {/* Report Configuration */}

        <Card className="border-slate-200">

          <CardHeader>

            <CardTitle>Report Configuration</CardTitle>

          </CardHeader>



          <CardContent className="space-y-4">

            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">

              <div>

                <Label>Report Type</Label>

                <Select value={reportType} onValueChange={setReportType}>

                  <SelectTrigger>

                    <SelectValue />

                  </SelectTrigger>

                  <SelectContent>

                    <SelectItem value="summary">Executive Summary</SelectItem>

                    <SelectItem value="detailed">Detailed Analysis</SelectItem>

                    <SelectItem value="risk">Risk Assessment</SelectItem>

                  </SelectContent>

                </Select>

              </div>



              <div>

                <Label>Department Filter</Label>

                <Select

                  value={selectedDepartment}

                  onValueChange={setSelectedDepartment}

                >

                  <SelectTrigger>

                    <SelectValue />

                  </SelectTrigger>

                  <SelectContent>

                    <SelectItem value="all">All Departments</SelectItem>

                    <SelectItem value="Engineering">Engineering</SelectItem>

                    <SelectItem value="Sales">Sales</SelectItem>

                    <SelectItem value="Marketing">Marketing</SelectItem>

                    <SelectItem value="HR">HR</SelectItem>

                    <SelectItem value="Finance">Finance</SelectItem>

                  </SelectContent>

                </Select>

              </div>



              <div>

                <Label>Risk Level Filter</Label>

                <Select

                  value={selectedRiskLevel}

                  onValueChange={setSelectedRiskLevel}

                >

                  <SelectTrigger>

                    <SelectValue />

                  </SelectTrigger>

                  <SelectContent>

                    <SelectItem value="all">All Risk Levels</SelectItem>

                    <SelectItem value="low">Low</SelectItem>

                    <SelectItem value="medium">Medium</SelectItem>

                    <SelectItem value="high">High</SelectItem>

                    <SelectItem value="critical">Critical</SelectItem>

                  </SelectContent>

                </Select>

              </div>

            </div>

          </CardContent>

        </Card>



        {/* Report Preview */}

        <Card className="border-slate-200">

          <CardHeader>

            <CardTitle>Report Preview</CardTitle>

          </CardHeader>



          <CardContent>

            <div className="space-y-4">

              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">

                <div className="p-4 bg-slate-50 rounded-lg">

                  <p className="text-sm text-slate-600 mb-1">Total Projects</p>

                  <p className="text-2xl font-bold text-slate-900">

                    {filteredProjects.length}

                  </p>

                </div>



                <div className="p-4 bg-red-50 rounded-lg">

                  <p className="text-sm text-red-600 mb-1">

                    High Risk Projects

                  </p>

                  <p className="text-2xl font-bold text-red-900">

                    {

                      filteredProjects.filter(

                        (p) =>

                          p.risk_level === "high" || p.risk_level === "critical"

                      ).length

                    }

                  </p>

                </div>



                <div className="p-4 bg-emerald-50 rounded-lg">

                  <p className="text-sm text-emerald-600 mb-1">

                    Avg Success Rate

                  </p>

                  <p className="text-2xl font-bold text-emerald-900">

                    {safeAvgSuccessRate}%

                  </p>

                </div>

              </div>



              <div className="pt-4 border-t border-slate-200">

                <h3 className="font-semibold text-slate-900 mb-3">

                  Included Projects

                </h3>



                <div className="space-y-2 max-h-60 overflow-y-auto">

                  {filteredProjects.map((p) => (

                    <div

                      key={p.id}

                      className="flex items-center justify-between p-2 bg-slate-50 rounded"

                    >

                      <span className="text-sm text-slate-900">

                        {p.project_name}

                      </span>



                      <span

                        className={`px-2 py-1 rounded text-xs font-medium ${

                          p.risk_level === "critical"

                            ? "bg-red-100 text-red-800"

                            : p.risk_level === "high"

                            ? "bg-amber-100 text-amber-800"

                            : p.risk_level === "medium"

                            ? "bg-blue-100 text-blue-800"

                            : "bg-emerald-100 text-emerald-800"

                        }`}

                      >

                        {p.risk_level}

                      </span>

                    </div>

                  ))}

                </div>

              </div>

            </div>

          </CardContent>

        </Card>



        {/* Export Options */}

        <Card className="border-slate-200">

          <CardHeader>

            <CardTitle>Export Report</CardTitle>

          </CardHeader>



          <CardContent>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">

              <Button

                onClick={generateCSV}

                className="bg-emerald-600 hover:bg-emerald-700 text-white h-20"

              >

                <FileDown className="w-6 h-6 mr-3" />

                <div className="text-left">

                  <div className="font-semibold">Export as CSV</div>

                  <div className="text-xs opacity-90">Spreadsheet format</div>

                </div>

              </Button>



              <Button

                onClick={generatePDFContent}

                className="bg-blue-600 hover:bg-blue-700 text-white h-20"

              >

                <FileText className="w-6 h-6 mr-3" />

                <div className="text-left">

                  <div className="font-semibold">Export as Text</div>

                  <div className="text-xs opacity-90">Document format</div>

                </div>

              </Button>

            </div>

          </CardContent>

        </Card>

      </div>

    </div>

  );

}
