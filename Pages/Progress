/* ===========================

   Contradiction detection logic

   - Flags conflicting or unrealistic behavioral inputs

   - No moralizing; just “this seems internally inconsistent”

   =========================== */

function contradictionChecks(skill, stage1Answers = {}, stage2Answers = {}) {

  const flags = [];



  // Helpers (stage1 scale: 1-5)

  const s = (signalKey) => stage1Answers?.[signalKey]?.value ?? null;



  if (skill === "Coding") {

    const abstraction = s("abstraction_comfort");

    const delayed = s("delayed_feedback_impact");

    const endurance = s("debugging_endurance_time");

    if (abstraction != null && abstraction >= 4 && endurance != null && endurance <= 2) {

      flags.push(

        "You indicated high comfort with abstract concepts, but low tolerance for prolonged unclear debugging. If both are accurate, consider clarifying whether your comfort changes under time pressure."

      );

    }

    if (delayed != null && delayed >= 4 && stage2Answers?.["feedback_absorption"] === "Motivated to improve") {

      flags.push(

        "You noted delayed feedback strongly affects motivation, while also describing feedback as motivating. This can be true in different contexts; you may want to note when feedback feels helpful vs draining."

      );

    }

  }



  if (skill === "Data Science") {

    const noCorrect = s("no_single_answer_comfort");

    const prob = s("probabilistic_decision_comfort");

    if (noCorrect != null && noCorrect <= 2 && prob != null && prob >= 4) {

      flags.push(

        "You reported low comfort with problems lacking a single correct answer, but high comfort with probabilistic decisions. If both are true, it may depend on how clearly the uncertainty is framed."

      );

    }

  }



  // Generic: extreme “very low” engagement + “very high” detail revisits

  if (skill === "Video Editing") {

    const engage = s("slow_progress_engagement");

    const detail = s("detail_revisit_frequency");

    if (engage != null && engage <= 2 && detail != null && detail >= 4) {

      flags.push(

        "You described slow-progress engagement as low, but frequent detail revisits as high. This can be true if revisiting details feels satisfying even when the overall progress feels slow."

      );

    }

  }



  return flags;

}



/* ===========================

   Risk-weight mapping tables (lightweight, explainable)

   NOTE: These produce “risk-relevant signals”, not deterministic scores.

   =========================== */

function toVectorStage1(stage1Answers) {

  // Normalize 1-5 -> 0-1

  const vec = {};

  Object.entries(stage1Answers || {}).forEach(([k, v]) => {

    const raw = v?.value;

    if (typeof raw === "number") vec[k] = clamp((raw - 1) / 4, 0, 1);

  });

  return vec;

}



function toVectorStage2(stage2Answers) {

  // Categorical responses mapped to stable tokens

  const vec = {};

  Object.entries(stage2Answers || {}).forEach(([signal, value]) => {

    vec[signal] = value ?? null;

  });

  return vec;

}



/* Produce descriptive insights (no “pass/fail”) */

function buildInsights(skill, context, stage1Answers, stage2Answers, stage3Signals) {

  const v1 = toVectorStage1(stage1Answers);

  const flags = contradictionChecks(skill, stage1Answers, stage2Answers);



  const observations = [];

  const tips = [];

  const resources = [];



  // Generic scaffolding: describe preference bands (low/mid/high)

  function describeBand(key, labelLow, labelMid, labelHigh) {

    const x = v1[key];

    if (x == null) return;

    if (x <= 0.33) observations.push(labelLow);

    else if (x <= 0.66) observations.push(labelMid);

    else observations.push(labelHigh);

  }



  if (skill === "Coding") {

    describeBand(

      "abstraction_comfort",

      "You indicated you prefer seeing practical anchors early when concepts feel abstract.",

      "You indicated you can work with abstraction when there are occasional concrete examples.",

      "You indicated you’re generally comfortable learning abstract concepts before immediate results."

    );

    describeBand(

      "delayed_feedback_impact",

      "Delayed feedback seems to have a lighter effect on your momentum.",

      "Delayed feedback affects momentum sometimes, depending on context.",

      "Delayed feedback has a noticeable effect on momentum; shorter feedback loops may help."

    );

    describeBand(

      "self_directed_docs",

      "You tend to prefer guided steps over documentation-first exploration.",

      "You use documentation when needed, alongside other supports.",

      "You’re comfortable using documentation and written references without step-by-step guidance."

    );



    tips.push(

      "If motivation dips when feedback is delayed, try tighter loops: smaller tasks, quicker tests, or earlier checkpoints."

    );

    tips.push(

      "When debugging is unclear, a short structured routine can help: isolate, log, simplify, then re-test."

    );

    resources.push("Practice approach: write a tiny failing test, then iterate until it passes.");

    resources.push("Reference habit: keep a personal “debug notes” log with patterns you notice.");

  }



  // Provide context modulation (job vs hobby/fun)

  const contextNote =

    context === "Job"

      ? "Context sensitivity: job settings often add deadlines and external expectations; you can use smaller checkpoints to keep feedback frequent."

      : "Context sensitivity: hobby/fun settings often allow exploration pacing; you can lean into curiosity-driven iterations and playful experimentation.";



  // Stage-3 (microtasks): descriptive signal integration

  if (stage3Signals?.notes) {

    observations.push(`Microtask notes: ${stage3Signals.notes}`);

  }



  return {

    skill,

    context,

    observations,

    tips,

    resources,

    consistencyFlags: flags,

    patternVectors: {

      stage1: v1,

      stage2: toVectorStage2(stage2Answers),

      stage3: stage3Signals ?? {},

    },

    contextNote,

  };

}



