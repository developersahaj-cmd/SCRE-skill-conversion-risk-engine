      />

      <Spacer />

      <div style={styles.label}>Short note (optional)</div>

      <textarea

        value={notes}

        onChange={(e) => setNotes(e.target.value)}

        rows={4}

        style={{ ...styles.input, resize: "vertical" }}

        placeholder="Example: what you tried first, what you noticed, what you would try next."

      />

      <Spacer />

      <button

        type="button"

        style={styles.button("primary")}

        onClick={() => {

          Analytics.track("microtask_done", { skill, hasNotes: Boolean(notes?.trim()) });

          onDone({ notes: notes?.trim() || null });

