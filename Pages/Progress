  return (

    <div style={styles.card}>

      <SectionTitle

        title="Stage 2: Situational Questions"

        subtitle="These explore cognitive style and behavioral alignment with the skill. They generate risk-relevant signals, not scores."

      />

      <Spacer />

      <div style={styles.pill}>Skill: {skill}</div>{" "}

      <div style={styles.pill}>Context: {context}</div>

      <Spacer h={16} />



      {qs.map((q) => {

        const current = answers?.[q.signal] ?? "";

        const isText = q.type === "text";

        return (

          <div key={q.id} style={{ padding: "12px 0" }}>

            <div style={{ fontWeight: 700 }}>{q.prompt}</div>

            <Spacer h={8} />

            {isText ? (

              <input

                value={current}

                onChange={(e) => setAnswers((p) => ({ ...p, [q.signal]: e.target.value }))}

                style={styles.input}

                placeholder="Short response"

              />

            ) : (

              <div style={{ display: "grid", gap: 8 }}>

                {q.options.map((opt) => {

                  const active = current === opt;

                  return (

                    <button

                      type="button"

                      key={opt}

                      style={styles.button(active ? "primary" : "secondary")}

                      onClick={() => setAnswers((p) => ({ ...p, [q.signal]: opt }))}

