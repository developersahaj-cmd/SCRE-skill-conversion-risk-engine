                      </option>

                    ))}

                  </select>

                </div>

              </Row>

              <Spacer />

              <div style={styles.small}>

                Stage flow: Stage 1 (signals) → Stage 2 (situations) → Stage 3

                (microtask reflection) → Report

              </div>

            </div>



            {stage === 1 ? (

              <>

                <Stage1

                  skill={skill}

                  answers={stage1Answers}

                  setAnswers={setStage1Answers}

                  context={context}

                />

                <Row style={{ justifyContent: "flex-end" }}>

                  <button

                    type="button"

                    style={styles.button("primary")}

                    onClick={() => {

                      if (!canContinueStage1()) return;

