/* ===========================

   UI primitives

   =========================== */

function Row({ children, style }) {

  return (

    <div style={{ display: "flex", gap: 12, alignItems: "center", ...style }}>

      {children}

    </div>

  );

}



function Spacer({ h = 12 }) {

  return <div style={{ height: h }} />;

}



function SectionTitle({ title, subtitle }) {

  return (

    <div>

      <div style={{ fontSize: 18, fontWeight: 800 }}>{title}</div>

      {subtitle ? <div style={{ ...styles.small, marginTop: 4 }}>{subtitle}</div> : null}

    </div>

  );

}



function Likert({ value, onChange, labels = ["1", "2", "3", "4", "5"] }) {

  return (

    <Row style={{ gap: 10, flexWrap: "wrap" }}>

      {labels.map((lab, idx) => {

        const v = idx + 1;

        const active = value === v;

        return (

          <button

            key={lab}

            type="button"

            onClick={() => onChange(v)}

            style={{

              ...styles.button(active ? "primary" : "secondary"),

              padding: "8px 10px",

              borderRadius: 999,

            }}

          >

            {lab}

          </button>

        );

      })}

    </Row>

  );

}



