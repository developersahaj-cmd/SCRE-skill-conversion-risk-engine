// SAFE INTEGRATION LAYER (Non-breaking)

// Optional, isolated adapters for future integrations.

// - No imports at top-level (prevents build/runtime crashes if SDKs missing)

// - Feature-flagged, lazy, try/catch wrapped

// - No-op fallbacks

const SAFE_FLAGS = {

  firebase: false,

  gemini: false,

  bigquery: false,

  vertex: false,

  vertexExplain: false,

};



// SAFE INTEGRATION LAYER (Non-breaking)

function getSafeEnv(key, fallback = undefined) {

  try {

    // Do NOT assume environment variables exist — guard everything.

    // Supports Vite (import.meta.env) and Node-style (process.env).

    const viteVal = typeof import.meta !== "undefined" && import.meta?.env ? import.meta.env[key] : undefined;

    const nodeVal = typeof process !== "undefined" && process?.env ? process.env[key] : undefined;

    return viteVal ?? nodeVal ?? fallback;

  } catch {

    return fallback;

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

function safeNoop() {

  return undefined;

}



// SAFE INTEGRATION LAYER (Non-breaking)

async function safeFirebaseAuthInit() {

  if (!SAFE_FLAGS.firebase) return { ok: false, reason: "disabled" };

  try {

    // Lazy load only when enabled.

    const firebaseAppMod = await import("firebase/app");

    const firebaseAuthMod = await import("firebase/auth");



    const apiKey = getSafeEnv("VITE_FIREBASE_API_KEY") ?? getSafeEnv("FIREBASE_API_KEY");

    const authDomain = getSafeEnv("VITE_FIREBASE_AUTH_DOMAIN") ?? getSafeEnv("FIREBASE_AUTH_DOMAIN");

    const projectId = getSafeEnv("VITE_FIREBASE_PROJECT_ID") ?? getSafeEnv("FIREBASE_PROJECT_ID");



    if (!apiKey || !authDomain || !projectId) return { ok: false, reason: "missing_config" };



    const { initializeApp, getApps } = firebaseAppMod;

    const { getAuth } = firebaseAuthMod;



    const app = (getApps && getApps().length) ? getApps()[0] : initializeApp({ apiKey, authDomain, projectId });

    const auth = getAuth(app);



    return { ok: true, auth };

  } catch {

    return { ok: false, reason: "unavailable" };

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

async function safeGeminiInsightGenerate(_prompt) {

  if (!SAFE_FLAGS.gemini) return { ok: false, insight: "" };

  try {

    // Intentionally no hard dependency on any Gemini SDK.

    // If you later add a Gemini client, do it here with lazy import + guards.

    return { ok: true, insight: "" };

  } catch {

    return { ok: false, insight: "" };

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

async function safeBigQueryLog(_event) {

  if (!SAFE_FLAGS.bigquery) return { ok: false };

  try {

    // Fire-and-forget analytics logging (async).

    // No hard dependency; safe fallback.

    return { ok: true };

  } catch {

    return { ok: false };

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

async function safeVertexInfer(_payload) {

  if (!SAFE_FLAGS.vertex) return { ok: false, result: null };

  try {

    // Vertex AI inference behind abstraction layer only.

    return { ok: true, result: null };

  } catch {

    return { ok: false, result: null };

  }

}



// SAFE INTEGRATION LAYER (Non-breaking)

async function safeVertexExplain(_payload) {

  if (!SAFE_FLAGS.vertexExplain) return { ok: false, explanation: null };

  try {

    // Vertex Explainable AI enrichment only if available.

    return { ok: true, explanation: null };

  } catch {

    return { ok: false, explanation: null };

  }

}



